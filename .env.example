# --- Sanity : contenu du site ET contacts ---
# Laissé vide : le site utilise src/data/seed.json et, en local, écrit les contacts dans .data/leads.jsonl
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Jeton "Editor". Sert à l'import initial (`npm run seed`) et à enregistrer les coups de cœur.
# Reste côté serveur : ne jamais le préfixer par PUBLIC_.
SANITY_WRITE_TOKEN=

# URL publique du site (balises de partage)
SITE_URL=
